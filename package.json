{
  "name": "@tsci/AnasSarkiz.rp2040-usb-c-single-axis-dm542t-motion-controller--01a0e89c",
  "version": "0.1.0-prototype.14",
  "description": "RP2040 USB-C Single-Axis Stepper Motion Controller for External DM542T Drivers with STEP/DIR/ENABLE Outputs and Dual Limit-Switch Inputs",
  "main": "index.circuit.tsx",
  "keywords": [
    "tscircuit",
    "circuit",
    "pcb",
    "electronics"
  ],
  "scripts": {
    "dev": "tsci dev",
    "build": "tsci build",
    "snapshot": "tsci snapshot",
    "start": "tsci dev",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write index.circuit.tsx lib scripts/build-bom.ts package.json project.json tsconfig.json biome.json",
    "format:check": "biome format index.circuit.tsx lib scripts/build-bom.ts package.json project.json tsconfig.json biome.json",
    "bom": "bun scripts/build-bom.ts",
    "test:board": "python3 tests/check-board.py --stage routed",
    "test:firmware": "cc -std=c11 -Wall -Wextra -Werror -fsanitize=address,undefined firmware/motion.c firmware/test_motion.c -lm -o firmware/test-motion && firmware/test-motion",
    "test": "bun run test:board && bun run test:connectivity && bun run test:firmware && bun run test:power && bun run test:via-spacing && bun run test:copper",
    "test:power": "cc -std=c11 -Wall -Wextra -Werror -fsanitize=address,undefined firmware/power_policy.c firmware/test_power_policy.c -o firmware/test-power && firmware/test-power",
    "test:placement": "python3 tests/check-board.py --stage placement",
    "test:connectivity": "firmware/.venv/bin/python scripts/check-copper-connectivity.py",
    "test:geometry": "firmware/.venv/bin/python tests/test-copper-geometry.py",
    "test:fabrication": "python3 scripts/check-fabrication.py",
    "test:silkscreen": "PYTHONPATH=scripts firmware/.venv/bin/python tests/test-silkscreen-geometry.py && firmware/.venv/bin/python scripts/check-silkscreen.py",
    "test:via-spacing": "python3 tests/test-via-spacing.py",
    "test:copper": "firmware/.venv/bin/python scripts/measure-copper.py"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "22.15.30",
    "gerber-to-svg": "4.2.8",
    "tscircuit": "0.0.2646",
    "typescript": "5.9.3"
  },
  "author": "AnasSarkiz",
  "title": "RP2040 USB-C Single-Axis Stepper Motion Controller for External DM542T Drivers with STEP/DIR/ENABLE Outputs and Dual Limit-Switch Inputs",
  "private": true,
  "hardwareRevision": "A0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AnasSarkiz/rp2040-usb-c-single-axis-dm542t-motion-controller.git"
  },
  "homepage": "https://tscircuit.com/AnasSarkiz/rp2040-usb-c-single-axis-dm542t-motion-controller--01a0e89c",
  "overrides": {
    "@tscircuit/core": "file:./tooling/packages/tscircuit-core-0.0.1971-a0.2.tgz",
    "@tscircuit/props": "file:./tooling/packages/tscircuit-props-0.0.666-a0.1.tgz",
    "@tscircuit/alphabet": "file:./tooling/packages/tscircuit-alphabet-0.0.25-a0.1.tgz"
  }
}
