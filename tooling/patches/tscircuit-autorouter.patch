@@ -0,0 +1,29 @@
+import type { SimpleRouteJson } from "lib/types"
+
+/** Convert the drill-edge rule to a conservative copper-edge search margin. */
+export const getPipeline9ViaCopperClearance = (params: {
+  originalSrj: SimpleRouteJson
+  defaultViaDiameter: number
+  defaultViaHoleDiameter: number
+  minimumCopperClearance: number
+}): number => {
+  const annularDiameters = [
+    params.defaultViaDiameter - params.defaultViaHoleDiameter,
+  ]
+  for (const trace of params.originalSrj.traces ?? []) {
+    for (const point of trace.route) {
+      if (point.route_type !== "via") continue
+      annularDiameters.push(
+        (point.via_diameter ?? params.defaultViaDiameter) -
+          (point.via_hole_diameter ?? params.defaultViaHoleDiameter),
+      )
+    }
+  }
+  // Taking the smallest annulus preserves the drill rule for mixed via sizes.
+  // The authoritative Circuit JSON check still evaluates each actual drill.
+  return Math.max(
+    params.minimumCopperClearance,
+    (params.originalSrj.minViaHoleEdgeToViaHoleEdgeClearance ?? 0) -
+      Math.min(...annularDiameters),
+  )
+}
